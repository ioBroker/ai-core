{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "target": "es2022",
        "lib": ["es2022"],
        "declaration": true,
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "useUnknownInCatchVariables": false,
        "outDir": "./build",
        "rootDir": "./src",
        "types": ["node", "@iobroker/types"]
    },
    "include": ["src/**/*"]
}
